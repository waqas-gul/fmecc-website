# Copy to .env.production (or .env.local) and fill in. Values are inlined at build time.

# Public origin of the deployed site, without a trailing slash (canonical URLs, Open Graph, sitemap).
NEXT_PUBLIC_SITE_URL=

# Formspree-compatible endpoint for the quotation form (JSON POST), e.g. https://formspree.io/f/<form id>.
# Web3Forms would also need its access key in the request body, which the form does not send.
# Empty: the form hands the request to the visitor's email app (needs the email in site.ts); while
# site.ts has TEMPORARY demoContact details it runs in demo mode instead (nothing is sent); otherwise
# it is shown disabled with an explanation.
NEXT_PUBLIC_FORM_ENDPOINT=

# Analytics measurement ID. Empty: no analytics script is loaded.
NEXT_PUBLIC_ANALYTICS_ID=
