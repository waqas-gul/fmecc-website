# Copy to .env.production (or .env.local) and fill in. Values are inlined at build time.

# Public origin of the deployed site, without a trailing slash (canonical URLs, Open Graph, sitemap).
NEXT_PUBLIC_SITE_URL=

# Formspree/Web3Forms-compatible endpoint for the quotation form. Empty: the form falls back to mailto.
NEXT_PUBLIC_FORM_ENDPOINT=

# Analytics measurement ID. Empty: no analytics script is loaded.
NEXT_PUBLIC_ANALYTICS_ID=
